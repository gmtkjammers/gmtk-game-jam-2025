[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D dirt : source_color;
uniform sampler2D grass : source_color;
uniform sampler2D tex_frg_5;
uniform float grass_baldness : hint_range(0.0, 5.0) = 2.0;


// TextureParameterTriplanar
	vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
		vec4 samp = vec4(0.0);
		samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
		samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
		samp += texture(p_sampler, p_triplanar_pos.zy * vec2(-1.0, 1.0)) * p_weights.x;
		return samp;
	}

	uniform vec3 triplanar_scale = vec3(1.0, 1.0, 1.0);
	uniform vec3 triplanar_offset;
	uniform float triplanar_sharpness = 0.5;

	varying vec3 triplanar_power_normal;
	varying vec3 triplanar_pos;

void vertex() {
// TextureParameterTriplanar
	{
		triplanar_power_normal = pow(abs(NORMAL), vec3(triplanar_sharpness));
		triplanar_power_normal /= dot(triplanar_power_normal, vec3(1.0));
		triplanar_pos = VERTEX * triplanar_scale + triplanar_offset;
		triplanar_pos *= vec3(1.0, -1.0, 1.0);
	}
}

void fragment() {
// Input:8
	mat4 n_out8p0 = INV_VIEW_MATRIX;


// Input:6
	vec3 n_out6p0 = VERTEX;


// TransformVectorMult:7
	vec3 n_out7p0 = (n_out8p0 * vec4(n_out6p0, 1.0)).xyz;
	float n_out7p1 = n_out7p0.r;
	float n_out7p3 = n_out7p0.b;


// VectorOp:11
	vec3 n_in11p1 = vec3(10.00000, 10.00000, 10.00000);
	vec3 n_out11p0 = n_out7p0 / n_in11p1;


// TextureParameterTriplanar:2
	vec4 n_out2p0 = triplanar_texture(dirt, triplanar_power_normal, n_out11p0);


// TextureParameterTriplanar:3
	vec4 n_out3p0 = triplanar_texture(grass, triplanar_power_normal, n_out11p0);


// VectorCompose:9
	vec2 n_out9p0 = vec2(n_out7p1, n_out7p3);


// VectorOp:10
	vec2 n_in10p1 = vec2(35.00000, 35.00000);
	vec2 n_out10p0 = n_out9p0 / n_in10p1;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out10p0);


// VectorDecompose:13
	float n_out13p0 = n_out3p0.x;
	float n_out13p1 = n_out3p0.y;
	float n_out13p2 = n_out3p0.z;
	float n_out13p3 = n_out3p0.w;


// FloatParameter:15
	float n_out15p0 = grass_baldness;


// FloatOp:14
	float n_out14p0 = pow(n_out13p3, n_out15p0);


	vec3 n_out12p0;
// ColorOp:12
	{
		float base = vec3(n_out5p0.xyz).x;
		float blend = vec3(n_out14p0).x;
		if (base < 0.5) {
			n_out12p0.x = 2.0 * base * blend;
		} else {
			n_out12p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out5p0.xyz).y;
		float blend = vec3(n_out14p0).y;
		if (base < 0.5) {
			n_out12p0.y = 2.0 * base * blend;
		} else {
			n_out12p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out5p0.xyz).z;
		float blend = vec3(n_out14p0).z;
		if (base < 0.5) {
			n_out12p0.z = 2.0 * base * blend;
		} else {
			n_out12p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Mix:4
	vec3 n_out4p0 = mix(vec3(n_out2p0.xyz), vec3(n_out3p0.xyz), n_out12p0.x);


// Output:0
	ALBEDO = n_out4p0;


}
